# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env stays local; .env.example IS committed.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Reference projects (read-only sources we merged — kept locally, not pushed).
/_argus/
/_forenix/

# Prisma dev sqlite + journal.
/prisma/dev.db
/prisma/dev.db-journal

# Per-case Git repositories created by the real-Git evidence engine.
/case-repos/
/prisma/migrations/dev*

# Logs from dev server output redirection.
dev.log
server.log
