# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env stays local; .env.example IS committed.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Reference projects (read-only sources we merged — kept locally, not pushed).
/_argus/
/_forenix/

# Prisma dev sqlite + journal.
/prisma/dev.db
/prisma/dev.db-journal

# Per-case Git repositories created by the real-Git evidence engine.
/case-repos/
/prisma/migrations/dev*

# Lazy-generated Ed25519 keypair for the Rekor attestation backend.
/.attestation-keys/

# Logs from dev server output redirection.
dev.log
server.log

# local-only / private (not for the public repo)
/private/
*.private.*

# Local symlink to the private forenix-saas overlay during dev.
# The actual src/lib/saas tree lives in the private repo; the deploy
# pipeline rsyncs it into place. Never commit the symlink.
src/lib/saas

# Deploy-stamped provenance ({commit, builtAt}), written by the Deploy
# workflow into the deploy root and read by /api/health. Per-deploy,
# never committed.
/.revision

# RQ2 eval run artifacts — regenerated by scripts/eval/run-eval.ts, not
# source. The methodology lives in docs/research/rq2-evaluation.md.
/scripts/eval/results/
/docs/research/rq2-pilot-results.md
