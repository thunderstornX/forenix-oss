# ── Database ────────────────────────────────────────────────────
# SQLite for local dev. For prod (Vercel), point at Postgres (Neon).
DATABASE_URL="file:./dev.db"

# ── AI adapter ──────────────────────────────────────────────────
# mock        → deterministic seeded JSON, zero API calls (default)
# ollama      → local Ollama HTTP API
# glm         → Zhipu AI GLM-4/5 (free tier)
# claude      → Anthropic Claude (SaaS premium only)
# openrouter  → OpenRouter proxy → many models (free + paid tiers)
# nvidia      → NVIDIA NIM hosted (free dev tier)
# grok        → xAI Grok (requires credits / DSP opt-in)
# groq        → Groq LPU inference (free, no card) ← FASTEST
AI_ADAPTER=mock

# Premium-feature gate. true = ClaudeAdapter, multi-tenant org, PDF export, ...
SAAS_MODE=false

# ── OllamaAdapter ───────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# ── GLMAdapter ──────────────────────────────────────────────────
# Free tier at https://open.bigmodel.cn
ZHIPU_API_KEY=
GLM_MODEL=glm-4-flash

# ── ClaudeAdapter (SaaS premium) ────────────────────────────────
# Requires SAAS_MODE=true. https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── OpenRouterAdapter ───────────────────────────────────────────
# Single key, many upstream models. https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_REFERER=https://github.com/thunderstornX/forenix-oss
OPENROUTER_TITLE=forenix-oss

# ── NVIDIAAdapter ───────────────────────────────────────────────
# Free dev tier. https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ── GrokAdapter (xAI) ───────────────────────────────────────────
# Requires credits OR Data Sharing Program opt-in. https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4-fast

# ── GroqAdapter (NOT xAI Grok) ──────────────────────────────────
# LPU inference. Free tier, no card. ~150ms median latency.
# https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── NextAuth ────────────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_TRUST_HOST=true

# ── Vercel demo seeding ─────────────────────────────────────────
# Token-gated bootstrap for POST /api/admin/seed-demo
# Generate with: openssl rand -hex 16
SEED_TOKEN=
