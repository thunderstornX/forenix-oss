# ── Database ────────────────────────────────────────────────────
# SQLite for local dev. For prod, point at Postgres.
DATABASE_URL="file:./dev.db"

# ── AI adapter ──────────────────────────────────────────────────
# mock  → deterministic seeded JSON, zero API calls (default).
# ollama → local Ollama HTTP API.
# glm    → Zhipu AI GLM-4/5 series.
# claude → Anthropic Claude (SaaS premium only).
AI_ADAPTER=mock

# Premium-feature gate. Set to "true" to enable the ClaudeAdapter,
# advanced OSINT sources, multi-tenant org management, etc.
SAAS_MODE=false

# ── OllamaAdapter ───────────────────────────────────────────────
# Local Ollama host (default: http://localhost:11434). After
# `ollama pull qwen2.5:7b-instruct`:
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# ── GLMAdapter ──────────────────────────────────────────────────
# Free tier available — register at https://open.bigmodel.cn
# and create a key under "API Keys".
ZHIPU_API_KEY=
GLM_MODEL=glm-4-flash

# ── ClaudeAdapter (SaaS premium) ────────────────────────────────
# Get a key at https://console.anthropic.com. Requires SAAS_MODE=true.
ANTHROPIC_API_KEY=
