# ── Database ────────────────────────────────────────────────────
# SQLite for local dev. For prod (Vercel), point at Postgres (Neon).
DATABASE_URL="file:./dev.db"

# ── AI adapter ──────────────────────────────────────────────────
# mock        → deterministic seeded JSON, zero API calls (default)
# ollama      → local Ollama HTTP API
# glm         → Zhipu AI GLM-4/5 (free tier)
# openrouter  → OpenRouter proxy → many models (free + paid tiers)
# nvidia      → NVIDIA NIM hosted (free dev tier)
# groq        → Groq LPU inference (free, no card) ← FASTEST
# claude      → ONLY available in the SaaS overlay at demo.forenix.tech.
#               OSS Core throws on construction. Pick a free adapter above.
AI_ADAPTER=mock

# Informational flag, no effect in OSS Core. The premium overlay that
# powers demo.forenix.tech reads SAAS_MODE=true to enable Claude +
# multi-tenant + billing + SSO + PDF export. There is no premium code
# in this repository, so flipping this in OSS does nothing.
SAAS_MODE=false

# ── OllamaAdapter ───────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# ── GLMAdapter ──────────────────────────────────────────────────
# Free tier at https://open.bigmodel.cn
ZHIPU_API_KEY=
GLM_MODEL=glm-4-flash

# ── ClaudeAdapter (SaaS overlay only) ───────────────────────────
# OSS Core does not include the Claude adapter; this variable is
# read only by the private SaaS overlay that powers demo.forenix.tech.
# Self-hosters can leave it blank.
ANTHROPIC_API_KEY=

# ── OpenRouterAdapter ───────────────────────────────────────────
# Single key, many upstream models. https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_REFERER=https://github.com/thunderstornX/forenix-oss
OPENROUTER_TITLE=forenix-oss

# ── NVIDIAAdapter ───────────────────────────────────────────────
# Free dev tier. https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ── GroqAdapter ─────────────────────────────────────────────────
# LPU inference. Free tier, no card. ~150ms median latency.
# https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── NextAuth ────────────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_TRUST_HOST=true

# ── Vercel demo seeding ─────────────────────────────────────────
# Token-gated bootstrap for POST /api/admin/seed-demo
# Generate with: openssl rand -hex 16
SEED_TOKEN=

# ── Visitor "Try the demo" button ───────────────────────────────
# When "true", forenix.tech shows a "try the demo" button on the
# marketing page that auto-signs the visitor in as a seeded viewer-
# role account. Set ONLY on the Vercel concept surface; leave UNSET
# on the DigitalOcean paid surface (which is invite-only and
# shouldn't offer a public backdoor).
DEMO_VISITOR_ENABLED=

# ── Cross-deployment waitlist sync ──────────────────────────────
# Forwards every waitlist signup on this deployment to another
# deployment's /api/admin/waitlist-import. Used so the Vercel
# concept surface mirrors signups into the paid SaaS at
# demo.forenix.tech, where admins approve invites. Unset on the
# DO droplet (no upstream); set on Vercel only.
#
# WAITLIST_SYNC_URL    full URL of the receiving endpoint
#                      (e.g. https://demo.forenix.tech/api/admin/waitlist-import)
# WAITLIST_SYNC_TOKEN  shared secret; must match on both sides
#                      Generate with: openssl rand -hex 32
# WAITLIST_SYNC_ORIGIN human-readable tag for where the row came
#                      from (default: "vercel-forenix-tech")
WAITLIST_SYNC_URL=
WAITLIST_SYNC_TOKEN=
WAITLIST_SYNC_ORIGIN=

# ── Scheduled Monitors  -  cron driver auth ─────────────────────
# Shared secret for POST /api/internal/monitor-tick. The scheduler
# accepts either MONITOR_CRON_TOKEN or Vercel's built-in CRON_SECRET
# (sent as "Bearer <secret>"). Generate with: openssl rand -hex 32.
# On Vercel, set CRON_SECRET in the project env  -  vercel.json's
# crons block automatically attaches it to the request.
# On the Droplet, set MONITOR_CRON_TOKEN here AND configure a
# systemd timer that curls the endpoint with the same value.
MONITOR_CRON_TOKEN=

# ── External attestation of the audit chain ─────────────────────
# Backends in src/lib/attestation/backends/. The default (`local`)
# stores an HMAC over the head, keyed on AUTH_SECRET, so the entire
# pipeline works out-of-the-box — but a real "DB admin re-signed
# the chain" defence needs an *external* witness like `github` or
# `rekor`.
ATTESTATION_BACKEND=local

# ── ATTEST_GITHUB_* (only needed when backend=github) ───────────
# A PAT with `issues:write` on the witness repo + the issue number
# of an open (ideally pinned + locked) issue to append comments to.
# https://github.com/settings/personal-access-tokens
ATTEST_GITHUB_TOKEN=
ATTEST_GITHUB_OWNER=
ATTEST_GITHUB_REPO=
ATTEST_GITHUB_ISSUE=

# ── REKOR_* (only needed when backend=rekor) ────────────────────
# Sigstore Rekor is a public transparency log run by the Sigstore
# Foundation. Posts a hashedrekord entry signed with a lazy-generated
# local Ed25519 keypair. https://rekor.sigstore.dev
REKOR_BASE_URL=https://rekor.sigstore.dev
# Where the Ed25519 keypair lives. Auto-created on first attest.
# 0600 on the private key; gitignored via `*.pem` + `/.attestation-keys/`.
REKOR_KEY_DIR=.attestation-keys
